# Backend listener. Keep this aligned with the Vite proxy unless both are changed together.
SERVER_ADDR=127.0.0.1:3000

# Optional persistent model cache location. Leave empty to use the platform cache directory.
SUBTITLE_MODEL_CACHE_DIR=

# Maximum uploaded video size in bytes. Default: 20 GiB.
SUBTITLE_MAX_UPLOAD_BYTES=21474836480

# Optional tracing filter understood by tracing-subscriber.
RUST_LOG=info
